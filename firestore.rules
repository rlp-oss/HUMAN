rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection check document
    match /test/connection {
      allow read: if true;
    }

    // Beta Testers collection
    match /testers/{testerId} {
      allow list: if true;
      allow get: if isValidId(testerId);
      allow create: if isValidId(testerId);
      allow update: if isValidId(testerId);
      allow delete: if isValidId(testerId);
    }

    // Feedbacks collection
    match /feedbacks/{feedbackId} {
      allow list: if true;
      allow get: if isValidId(feedbackId);
      allow create: if isValidId(feedbackId);
      allow update: if isValidId(feedbackId);
      allow delete: if isValidId(feedbackId);
    }

    // Broadcasts collection
    match /broadcasts/{broadcastId} {
      allow list: if true;
      allow get: if isValidId(broadcastId);
      allow create: if isValidId(broadcastId);
      allow update: if isValidId(broadcastId);
      allow delete: if isValidId(broadcastId);
    }

    // Creator Claims collection
    match /creator_claims/{claimId} {
      allow list: if true;
      allow get: if isValidId(claimId);
      allow create: if isValidId(claimId);
      allow update: if isValidId(claimId);
      allow delete: if isValidId(claimId);
    }

    // App Badges & C2PA Manifest records
    match /app_badges/{badgeId} {
      allow list: if true;
      allow get: if isValidId(badgeId);
      allow create: if isValidId(badgeId);
      allow update: if isValidId(badgeId);
      allow delete: if isValidId(badgeId);
    }
  }
}

